<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MaxPlay - Live Stream Tester</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- HLS.js CDN for .m3u8 Video Playback -->
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
</head>
<body class="bg-zinc-950 text-white font-sans min-h-screen">

  <!-- Header -->
  <header class="bg-zinc-900 border-b border-zinc-800 p-4 sticky top-0 z-50 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="text-red-600 font-extrabold text-2xl tracking-wider">MAXPLAY</span>
      <span class="text-xs bg-red-600/20 text-red-400 px-2.5 py-1 rounded-full border border-red-500/30 font-mono">LIVE TV TEST</span>
    </div>

    <!-- M3U Playlist URL Input -->
    <div class="flex flex-1 max-w-xl gap-2">
      <input 
        type="url" 
        id="m3uUrlInput" 
        value="https://iptv-org.github.io/iptv/countries/af.m3u" 
        class="flex-1 bg-zinc-800 border border-zinc-700 text-xs text-white rounded-lg px-3 py-2 focus:outline-none focus:border-red-500"
      />
      <button 
        onclick="fetchAndParseM3U()" 
        class="bg-red-600 hover:bg-red-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition-all"
      >
        Load Playlist
      </button>
    </div>
  </header>

  <main class="max-w-7xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left Column: Main Live Video Player (2 Cols on Large Screens) -->
    <div class="lg:col-span-2 space-y-4">
      <div class="relative bg-black rounded-2xl overflow-hidden shadow-2xl border border-zinc-800 aspect-video">
        <video id="liveVideo" class="w-full h-full object-contain" controls autoplay></video>
      </div>

      <!-- Channel Active Info -->
      <div class="bg-zinc-900 border border-zinc-800 p-4 rounded-xl flex items-center justify-between">
        <div>
          <h2 id="activeChannelTitle" class="text-lg font-bold text-white">Select a Channel</h2>
          <p id="activeChannelUrl" class="text-xs text-zinc-500 font-mono truncate max-w-md mt-1">No stream loaded</p>
        </div>
        <span id="liveBadge" class="hidden bg-red-600 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-full animate-pulse">
          LIVE
        </span>
      </div>
    </div>

    <!-- Right Column: Channels List Sidebar -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex flex-col h-[600px]">
      <div class="flex items-center justify-between mb-3 pb-2 border-b border-zinc-800">
        <h3 class="text-sm font-bold text-zinc-300">Channels List</h3>
        <span id="channelCount" class="text-xs bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded-full">0 Loaded</span>
      </div>

      <!-- Status/Loading Text -->
      <div id="statusText" class="text-xs text-yellow-400 mb-2">Loading playlist automatically...</div>

      <!-- Scrollable Channel List -->
      <div id="channelList" class="flex-1 overflow-y-auto space-y-2 pr-1">
        <!-- Dynamic Channel Items Will Render Here -->
      </div>
    </div>

  </main>

  <script>
    let hlsInstance = null;
    let parsedChannels = [];

    // Auto load on page start
    window.addEventListener('DOMContentLoaded', () => {
      fetchAndParseM3U();
    });

    // 1. Fetch M3U file and Parse channels dynamically
    async function fetchAndParseM3U() {
      const url = document.getElementById('m3uUrlInput').value;
      const statusText = document.getElementById('statusText');
      const channelList = document.getElementById('channelList');

      if (!url) return;

      statusText.innerText = "Fetching M3U playlist...";
      channelList.innerHTML = "";

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error("Network response failed");
        
        const m3uText = await response.text();
        parsedChannels = parseM3UContent(m3uText);

        document.getElementById('channelCount').innerText = `${parsedChannels.length} Channels`;
        statusText.innerText = `Loaded ${parsedChannels.length} channels successfully!`;
        statusText.className = "text-xs text-green-400 mb-2";

        renderChannelList(parsedChannels);

        // Auto play 1st channel if available
        if (parsedChannels.length > 0) {
          playStream(parsedChannels[0].url, parsedChannels[0].title);
        }

      } catch (error) {
        console.error(error);
        statusText.innerText = "Error fetching M3U. Check CORS or URL.";
        statusText.className = "text-xs text-red-400 mb-2";
      }
    }

    // 2. M3U Parser Function
    function parseM3UContent(text) {
      const lines = text.split('\n');
      const channels = [];
      let currentChannel = {};

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();

        if (line.startsWith('#EXTINF:')) {
          // Extract Name
          const nameMatch = line.match(/,(.+)$/);
          const name = nameMatch ? nameMatch[1].trim() : 'Unknown Channel';

          // Extract Logo
          const logoMatch = line.match(/tvg-logo="([^"]+)"/);
          const logo = logoMatch ? logoMatch[1] : '';

          currentChannel = { title: name, logo: logo };
        } else if (line.startsWith('http://') || line.startsWith('https://')) {
          currentChannel.url = line;
          channels.push(currentChannel);
          currentChannel = {};
        }
      }

      return channels;
    }

    // 3. Render Channels to UI
    function renderChannelList(channels) {
      const channelList = document.getElementById('channelList');
      channelList.innerHTML = "";

      channels.forEach((ch, index) => {
        const item = document.createElement('div');
        item.className = "flex items-center gap-3 p-2.5 rounded-xl bg-zinc-800/50 hover:bg-red-600/20 border border-zinc-700/50 hover:border-red-500/50 cursor-pointer transition-all";
        item.onclick = () => playStream(ch.url, ch.title);

        const imgHtml = ch.logo 
          ? `<img src="${ch.logo}" onerror="this.src='https://via.placeholder.com/40?text=TV'" class="w-8 h-8 rounded-lg object-contain bg-black p-0.5" />`
          : `<div class="w-8 h-8 rounded-lg bg-zinc-700 flex items-center justify-center text-xs font-bold">TV</div>`;

        item.innerHTML = `
          ${imgHtml}
          <div class="flex-1 overflow-hidden">
            <p class="text-xs font-bold text-white truncate">${ch.title}</p>
            <p class="text-[10px] text-zinc-500 truncate">${ch.url}</p>
          </div>
        `;

        channelList.appendChild(item);
      });
    }

    // 4. Play Selected Stream with HLS.js
    function playStream(streamUrl, title) {
      const video = document.getElementById('liveVideo');
      document.getElementById('activeChannelTitle').innerText = title;
      document.getElementById('activeChannelUrl').innerText = streamUrl;
      document.getElementById('liveBadge').classList.remove('hidden');

      if (Hls.isSupported()) {
        if (hlsInstance) {
          hlsInstance.destroy();
        }

        hlsInstance = new Hls({
          enableWorker: true,
          lowLatencyMode: true
        });

        hlsInstance.loadSource(streamUrl);
        hlsInstance.attachMedia(video);

        hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => {
          video.play().catch(e => console.log("Autoplay click required"));
        });

        hlsInstance.on(Hls.Events.ERROR, (event, data) => {
          if (data.fatal) {
            console.warn("HLS Error:", data);
          }
        });

      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = streamUrl;
        video.play();
      }
    }
  </script>
</body>
</html>
