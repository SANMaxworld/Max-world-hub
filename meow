<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Direct Video Downloader</title>
    <style>
        body {
            background: #0d0d12;
            color: #fff;
            font-family: sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .btn {
            background: #7c3aed;
            color: white;
            border: none;
            padding: 16px 24px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 12px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
        }
        .btn:disabled { background: #444; }
        #status { margin-top: 15px; font-size: 14px; color: #06b6d4; text-align: center; }
    </style>
</head>
<body>

    <div style="text-align: center;">
        <button id="dlBtn" class="btn" onclick="downloadMp4Direct('https://files.catbox.moe/lz21c6.mp4', 'MaxPlay_Video.mp4')">
            ⬇️ Download MP4 File
        </button>
        <div id="status"></div>
    </div>

    <script>
        function downloadMp4Direct(catboxUrl, fileName) {
            const btn = document.getElementById('dlBtn');
            const status = document.getElementById('status');
            
            btn.disabled = true;
            status.innerText = "⏳ Video file prepare ho rahi hai...";

            // CORS Proxy URL ke sath fetch
            const proxiedUrl = 'https://corsproxy.io/?' + encodeURIComponent(catboxUrl);

            fetch(proxiedUrl)
                .then(res => {
                    if (!res.ok) throw new Error("File fetch fail ho gayi");
                    return res.blob();
                })
                .then(blob => {
                    // Force MP4 MIME Type
                    const mp4Blob = new Blob([blob], { type: 'video/mp4' });
                    const url = window.URL.createObjectURL(mp4Blob);
                    
                    const a = document.createElement('a');
                    a.style.display = 'none';
                    a.href = url;
                    a.download = fileName; // Ensure .mp4 extension
                    
                    document.body.appendChild(a);
                    a.click();
                    
                    setTimeout(() => {
                        window.URL.revokeObjectURL(url);
                        document.body.removeChild(a);
                        status.innerText = "✅ MP4 Download Shuru Ho Gaya!";
                        btn.disabled = false;
                    }, 1000);
                })
                .catch(err => {
                    console.error(err);
                    status.innerText = "❌ Download Fail!";
                    btn.disabled = false;
                });
        }
    </script>

</body>
</html>
